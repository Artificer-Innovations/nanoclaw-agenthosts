{
  "name": "nanoclaw-agenthosts",
  "version": "0.2.1",
  "description": "Pluggable agent process lifecycle (RuntimeDriver registry) for NanoClaw",
  "type": "module",
  "license": "MIT",
  "author": "Artificer Innovations, LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Artificer-Innovations/nanoclaw-agenthosts"
  },
  "homepage": "https://github.com/Artificer-Innovations/nanoclaw-agenthosts",
  "bugs": {
    "url": "https://github.com/Artificer-Innovations/nanoclaw-agenthosts/issues"
  },
  "keywords": [
    "nanoclaw",
    "agenthosts",
    "runtime",
    "skills",
    "extensions"
  ],
  "bin": {
    "nanoclaw-agenthosts": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "api-contract.md",
    "README.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @nanoclaw-agenthosts/shared build && pnpm --filter @nanoclaw-agenthosts/host build && pnpm --filter @nanoclaw-agenthosts/cli build && node scripts/sync-resources.mjs && prettier --write skills/add-agenthosts/resources/host >/dev/null && node scripts/verify-publish-entry.mjs",
    "typecheck": "pnpm --filter @nanoclaw-agenthosts/shared --filter @nanoclaw-agenthosts/host --filter @nanoclaw-agenthosts/cli typecheck",
    "lint": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "lint:fix": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "test:unit": "pnpm -r test:unit",
    "test:coverage": "pnpm --filter @nanoclaw-agenthosts/host --filter @nanoclaw-agenthosts/cli test:coverage",
    "test:integration": "node scripts/run-integration.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release:publish": "npm publish --provenance --access public",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "4.1.12",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@vitest/coverage-v8": "4.1.12",
      "@vitest/mocker": "4.1.12",
      "js-yaml@>=3.0.0 <4": "3.15.2",
      "js-yaml@>=4.0.0 <5": "4.3.2",
      "nanoid": "3.3.18",
      "source-map-js": "1.2.2",
      "vite": "7.3.7",
      "vitest": "4.1.12"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
